Algoritmo "potencia"
// EXPONENCIAÇÃO
Var
 numero: inteiro
 quadrado, cubo: real
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
 Escreval ("Digite um número: ")
 Leia (numero)
 quadrado <- exp(numero,2)
 cubo <- exp(numero,3)
 Escreval (numero, " ao quadrado é igual a", quadrado)
 Escreval (numero, " ao cubo é igual a", cubo)
Fimalgoritmo