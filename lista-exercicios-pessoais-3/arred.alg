Algoritmo "valores"
Var
  numero: inteiro
  raiz_quadrada: real
  exponente: real
  absoluto: real
inicio
   Escreva ("Digite um número: ")
   Leia (numero)
   raiz_quadrada <- raizq(numero)
   exponente <- exp(numero,2)
   absoluto <- abs(numero)
   Escreval ("Raiz quadrada: ", raiz_quadrada)
   Escreval ("Ao quadrado: ", exponente)
   Escreval ("Absoluto: ",absoluto)
FimAlgoritmo