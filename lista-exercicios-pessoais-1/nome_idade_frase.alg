Algoritmo "nome_idade_frase"
// Peça o nome
//	Peça a idade
//	Mostre tudo organizado em uma frase

Var
  nome: caractere
  idade: inteiro
Inicio
  Escreval ("What's your name?")
  Leia (nome)
  Escreval ("What's your age?")
  Leia (idade)
  Escreval ("Your name is ", nome, " and your age is", idade)
Fimalgoritmo