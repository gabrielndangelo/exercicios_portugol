Algoritmo "frase_n_i"
// Crie um algoritmo que simule um pequeno diálogo
Var
 nome: caractere
 idade: inteiro
Inicio
  Escreval ("Qual o seu nome?")
  Leia (nome)
  Escreval ("Qual a sua idade?")
  Leia (idade)
  Escreval ("Olá,", nome, "! Você tem", idade, " anos. Seja bem-vindo!")
Fimalgoritmo