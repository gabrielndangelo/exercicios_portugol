Algoritmo "maior"
Var
n1, n2: inteiro
Inicio
  Escreval ("Digite um número:")
  Leia (n1)
  Escreval ("Digite outro número:")
  Leia (n2)
   se n1 < n2 entao
   Escreval (n2, " é maior que", n1)
   fimse
   
   se n1 > n2 entao
   Escreval (n1, " é maior que", n2)
   fimse
   
   se n1 = n2 entao
   Escreval ("Os dois números são iguais!")
   fimse
   
Fimalgoritmo