Algoritmo "media com 2"
// Média de duas avaliações
Var
  av1, av2: inteiro
  media: real

Inicio
  Escreval ("Digite sua nota da primeira avaliação:")
  Leia (av1)
  Escreval ("Digite sua nota da segunda avaliação:")
  Leia (av2)
  media <- (av1+av2) / 2
  Escreval ("Sua média é", media)

Fimalgoritmo