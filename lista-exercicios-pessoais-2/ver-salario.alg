Algoritmo "semnome"
// Leia o número de dias trabalhados e mostre o salário: Considere R$ 50 por dia
Var
 dias: inteiro
 salario: real
Inicio
 Escreva ("VERIFICADOR DE SALÁRIO: Quantos dias você trabalhou esse mês?")
 Leia (dias)
 salario <- (50 * dias)
 Escreval ("Salário do mês:", salario)
Fimalgoritmo